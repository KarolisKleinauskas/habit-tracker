# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real secrets.

# --- Database (Neon Postgres) -------------------------------------------------
# Neon console → your project → Dashboard → "Connect" → copy the connection string.
# Use the POOLED connection string (host contains "-pooler") with ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection, used by drizzle-kit for migrations. Same as above without "-pooler".
# `neon link` fills both automatically.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth --------------------------------------------------------------
# Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Public base URL of the app. Locally http://localhost:3000, in production your Vercel URL.
BETTER_AUTH_URL="http://localhost:3000"

# --- Web Push (VAPID) ---------------------------------------------------------
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
# The public key is exposed to the browser (hence NEXT_PUBLIC_), the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, "mailto:you@example.com" or an https URL.
VAPID_SUBJECT="mailto:you@example.com"

# --- Cron ---------------------------------------------------------------------
# Shared secret that cron-job.org sends as "Authorization: Bearer <CRON_SECRET>"
# when calling /api/cron/reminders. Generate like BETTER_AUTH_SECRET.
CRON_SECRET=""
